 "paths": {
  "/voice/v1/cards.list": {
   "post": {
    "summary": "The customer's cards the assistant may talk about",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "data": {
          "type": "object",
          "properties": {
           "customerNo": {
            "oneOf": [
             {
              "type": "string"
             },
             {
              "type": "integer"
             }
            ],
            "description": "8-digit customer number"
           },
           "aiFlow": {
            "type": "string",
            "example": "CardOps"
           }
          },
          "required": [
           "customerNo"
          ]
         },
         "call": {
          "type": "object",
          "properties": {
           "ani": {
            "type": "string",
            "description": "caller's number"
           },
           "lang": {
            "type": "string",
            "example": "tr"
           }
          }
         }
        },
        "required": [
         "data"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "success",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "data": {
           "type": "object",
           "properties": {
            "cards": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "cardNumber": {
                "type": "string"
               },
               "cardNumberLast4": {
                "type": "string"
               },
               "productName": {
                "type": "string"
               },
               "status": {
                "type": "string"
               },
               "isMainCard": {
                "type": "boolean"
               }
              }
             }
            },
            "validCardsCount": {
             "type": "integer"
            },
            "exitState": {
             "type": "string",
             "enum": [
              "1_CARD",
              "MULTI_CARD"
             ]
            }
           }
          },
          "result": {
           "type": "object",
           "properties": {
            "guid": {
             "type": "string"
            },
            "returnCode": {
             "type": "string",
             "description": "\"1\" on success, else the error code"
            },
            "messageText": {
             "type": "string"
            },
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "type": {
             "type": "string",
             "nullable": true,
             "description": "null, ERROR or WARNING"
            },
            "details": {
             "type": "object",
             "properties": {
              "guid": {
               "type": "string"
              },
              "rootCause": {
               "type": "string",
               "nullable": true
              },
              "errorOrigin": {
               "type": "string",
               "nullable": true
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "INVALID_ARGUMENTS_ERROR: a required field is missing or empty, or no entry in the test data"
     },
     "404": {
      "description": "not found (code per service, contract section 4)"
     },
     "500": {
      "description": "FBE00099: technical error"
     }
    }
   }
  },
