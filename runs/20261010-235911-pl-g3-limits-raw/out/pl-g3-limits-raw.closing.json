    {
     "source": "briefs/pl-g3-limits-raw.md",
     "quote": "Freya Bank calls customers who are 1 to 45 days late on one product."
    }
   ]
  },
  "attempts": {
   "allowed": "attempts_allowed_{i}",
   "max": 3,
   "evidence": [
    {
     "source": "briefs/pl-g3-limits-raw.md",
     "quote": "days_late: 8 to 45; Band: late; Deadline: the 7th business day after today; Persuasion attempts: 3"
    }
   ]
  },
  "refusal": "refused_{i}_{a}"
